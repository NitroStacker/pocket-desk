{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pocketdesk-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "EXPO_PROJECT_URL": "exp://like-mailto-cheque-promptly.trycloudflare.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_SESSION",
        "class_name": "RelaySession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelaySession"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
